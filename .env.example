# ============================================================
# SMART SMOE IFDL — Variables d'environnement locales
# Copier ce fichier en .env et ajuster les valeurs
# ============================================================

# ── Base de données PostgreSQL ───────────────────────────────
DB_USER=smoe_user
DB_PASSWORD=smoe_password_2024
DB_NAME=smoe_ifdl
DB_PORT=5432

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=smoe_redis_2024
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=smoe-jwt-super-secret-key-change-in-production
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=smoe-refresh-secret-key-change-in-production

# ── Ports exposés ────────────────────────────────────────────
BACKEND_PORT=3001
FRONTEND_PORT=3000

# ── URLs ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
FRONTEND_URL=http://localhost:3000

# ── OpenAI (optionnel — pour l'assistant IA) ─────────────────
OPENAI_API_KEY=

# ── SMTP (optionnel — pour les notifications email) ──────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smoe-ifdl.ma

# ── pgAdmin (interface admin PostgreSQL) ─────────────────────
PGADMIN_EMAIL=admin@smoe-ifdl.ma
PGADMIN_PASSWORD=admin123
