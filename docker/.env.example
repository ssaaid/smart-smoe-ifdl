# ============================================================
# SMART SMOE IFDL — Variables d'environnement
# Copier vers .env et adapter vos valeurs
# NE PAS committer ce fichier avec de vraies valeurs !
# ============================================================

# ── Application ──────────────────────────────────────────────
NODE_ENV=production
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ── Database PostgreSQL ──────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=smoe_user
DB_PASSWORD=CHANGEME_STRONG_DB_PASSWORD_MIN_16_CHARS
DB_NAME=smoe_ifdl
DB_SSL=false

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME_REDIS_PASSWORD_MIN_16_CHARS

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=CHANGEME_JWT_SECRET_MIN_32_RANDOM_CHARS_HERE
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGEME_REFRESH_SECRET_DIFFERENT_FROM_JWT_SECRET

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=https://smoe.esef-berrechid.ma
NEXT_PUBLIC_API_URL=https://smoe.esef-berrechid.ma/api/v1
NEXT_PUBLIC_APP_NAME=SMART SMOE IFDL

# ── OpenAI (IA SMOE Assistant) ───────────────────────────────
OPENAI_API_KEY=sk-proj-VOTRE_CLE_OPENAI_ICI
OPENAI_MODEL=gpt-4o-mini

# ── Email SMTP ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smoe@esef-berrechid.ma
SMTP_PASS=CHANGEME_SMTP_APP_PASSWORD
SMTP_FROM=noreply@esef-berrechid.ma
SMTP_FROM_NAME=SMART SMOE IFDL

# ── Supabase Storage ─────────────────────────────────────────
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_BUCKET=smoe-documents

# ── pgAdmin (développement seulement) ────────────────────────
PGADMIN_EMAIL=admin@smoe-ifdl.ma
PGADMIN_PASSWORD=CHANGEME_PGADMIN_PASSWORD
